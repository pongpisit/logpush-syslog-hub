{
  "name": "logpush-syslog-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Cloudflare Logpush -> Syslog (CEF) forwarding hub with a web UI for managing multiple TCP destinations.",
  "license": "MIT",
  "packageManager": "pnpm@8.10.5",
  "scripts": {
    "dev:api": "pnpm --filter @logpush-syslog-hub/api dev",
    "dev:web": "pnpm --filter @logpush-syslog-hub/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
